# Copy to .env for running the app locally (`cp .env.example .env`).
# .env is gitignored. Replace the placeholders with your own Firebase values.
# These are bundled into the app, so they are not secrets in the Expo sense,
# but do not commit real ones anyway.
EXPO_PUBLIC_FIREBASE_API_KEY=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_APP_ID=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_PROJECT_ID=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=SECRET_REQUIRED_HERE
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=SECRET_REQUIRED_HERE

# Only for the manual "EAS Build" GitHub workflow. Do NOT put it in .env:
# add it as a repository secret (Settings > Secrets and variables > Actions).
# Create the token at https://expo.dev/settings/access-tokens
# EXPO_TOKEN=SECRET_REQUIRED_HERE
